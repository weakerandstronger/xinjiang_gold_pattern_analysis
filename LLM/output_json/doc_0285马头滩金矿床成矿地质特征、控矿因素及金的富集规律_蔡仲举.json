"name_zh": "黄铁矿",
"attributes": {
"name": "黄铁矿",
"role_in_ore": "重要载金矿物",
"paragenesis": "与磁铁矿相伴呈浸染状、细脉状分布于绿泥石集合体中，亦可与黄铜矿、方铅矿、闪锌矿等共生于石英脉中"
